<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make with your current pantry ingredients."
        android:textSize="15sp"
        android:textColor="#526174"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/textEmptyRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recipes available yet. Add the required ingredients and quantities to your pantry, then check again."
        android:textSize="16sp"
        android:textColor="#526174"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE2EA"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>