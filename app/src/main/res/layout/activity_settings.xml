<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen, styled to match the Suggested Recipes screen. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F5"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    tools:context=".SettingsActivity">

    <!-- Brand label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_label"
        android:textColor="#26734D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <!-- Main heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_title"
        android:textColor="#173D2D"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:text="@string/settings_subtitle"
        android:textColor="#718078"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Expiry alerts card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#E4ECE5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_expiry_alerts"
                    android:textColor="#173D2D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/settings_expiry_alerts_summary"
                    android:textColor="#52685A"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_expiry_alerts" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Back to the pantry -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettingsBack"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/settings_back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#28734F"
        app:cornerRadius="16dp" />

</LinearLayout>
