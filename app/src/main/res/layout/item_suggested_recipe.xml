<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E1EAE2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Simple green checkmark icon -->
        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#E7F1E9"
            android:gravity="center"
            android:text="✓"
            android:textColor="#26734D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Recipe information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/recipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banana Smoothie"
                android:textColor="#173D2D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/recipeIngredientCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 required ingredients"
                android:textColor="#26734D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/recipeIngredientPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bananas, milk, honey"
                android:textColor="#718078"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- Opens recipe details -->
        <TextView
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#26734D"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>